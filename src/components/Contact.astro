---
import { PROJECTS } from '../data/projects';
import { CONTACT, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = ui.contact;
// акцент — пастельний градієнт Clarity
const clarity = PROJECTS.find((p) => p.slug === 'clarity')!;
const socials = [
  { label: 'GitHub', href: CONTACT.github },
  { label: 'LinkedIn', href: CONTACT.linkedin },
  { label: 'Telegram', href: CONTACT.telegram },
  { label: 'X', href: CONTACT.x },
];
---

<section
  class="sheet theme-light contact"
  id="contact"
  data-section
  aria-labelledby="contact-title"
  style={`--accent: ${clarity.accent}; --on-accent: ${clarity.onAccent}; --glow: ${clarity.panel}`}
>
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container">
    <span class="kicker" data-reveal>{c.kicker[lang]}</span>
    <h2 class="contact__title display" id="contact-title" data-reveal>{c.title[lang]}</h2>
    <p class="lead contact__lead" data-reveal>{c.lead[lang]}</p>

    <div class="contact__email" data-reveal>
      <a href={`mailto:${CONTACT.email}`} class="contact__mail">{CONTACT.email}</a>
      <button type="button" class="btn btn--ghost" data-copy={CONTACT.email} data-copied-label={c.copied[lang]}>
        <span data-copy-label>{c.copy[lang]}</span>
      </button>
    </div>

    <div class="contact__actions" data-reveal>
      <a href={CONTACT.telegram} class="btn" target="_blank" rel="noopener">
        {c.telegram[lang]} <span class="arrow arrow--ne" aria-hidden="true">→</span>
      </a>
      <ul class="contact__socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener me" class="link">
                {s.label} <span class="arrow arrow--ne" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(120px, 14vw, 220px);
  }

  .contact__glow {
    position: absolute;
    left: 40%;
    top: 10%;
    z-index: -1;
    width: 70vw;
    aspect-ratio: 1.6;
    border-radius: 50%;
    background: var(--glow);
    filter: blur(80px);
    opacity: 0.75;
  }

  .contact__title {
    margin-top: 28px;
    font-size: var(--step-4);
    max-width: 11ch;
  }

  .contact__lead {
    margin-top: 28px;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: clamp(48px, 7vw, 96px);
    padding-block: 28px;
    border-block: 1px solid var(--line);
  }

  .contact__mail {
    font-size: clamp(1.3rem, 0.5rem + 3.6vw, 4.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    padding-bottom: 6px;
    transition: background-size 0.6s var(--ease-out);
  }

  .contact__mail:hover {
    background-size: 100% 2px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 32px;
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  .contact__socials .link {
    background-size: 0 1.5px;
  }

  .contact__socials .link:hover {
    background-size: 100% 1.5px;
    color: var(--fg);
  }
</style>
