---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Work from '../../components/Work.astro';
import Services from '../../components/Services.astro';
import Awards from '../../components/Awards.astro';
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';
import { LANGS, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const meta = {
  uk: {
    title: 'Олексій Безклинський — дизайн і розробка сайтів',
    description:
      'Проєктую і розробляю сайти та вебзастосунки: від ідеї й дизайну до коду й запуску. Кременчук, Україна. 3 місце у Всеукраїнському турнірі з програмування 2026.',
  },
  en: {
    title: 'Oleksii Bezklynskyi — website design & development',
    description:
      'I design and build websites and web apps, from idea and design to code and launch. Kremenchuk, Ukraine. 3rd place at the All-Ukrainian programming tournament 2026.',
  },
}[lang];
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Hero lang={lang} />
  <Work lang={lang} />
  <Services lang={lang} />
  <Awards lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</Base>
